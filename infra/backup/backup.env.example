# Copy to backup.env (gitignored pattern: infra/backup/*.env is not committed). Read by nuvia-backup.service.
BACKUP_GPG_PUBLIC_KEY_FILE=/opt/nuvia/infra/backup/backup-public.asc
BACKUP_DIR=/var/backups/nuvia
BACKUP_RETENTION_DAYS=14
# Second copy in a storage account the company owns, in another region. Sign in first: az login --identity
BACKUP_OFFSITE_ACCOUNT=
BACKUP_OFFSITE_CONTAINER=nuvia-backups
