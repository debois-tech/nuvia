# Copy to .env (or run ./scripts/gen-secrets.sh, which fills the secrets for you). Never commit .env.

# Name staff type in the browser. Resolve it to VPN_BIND_ADDR through the WireGuard DNS setting or a hosts entry.
NUVIA_HOSTNAME=nuvia.internal
# Exactly what staff type in the browser, scheme and host (and port if not 443), no trailing slash.
# The API rejects state-changing requests from any other origin.
APP_ORIGIN=https://nuvia.internal

# The WireGuard address of the server, e.g. 10.8.0.1. HTTPS is published on this address only.
VPN_BIND_ADDR=10.8.0.1
HTTPS_PORT=443

POSTGRES_USER=nuvia
POSTGRES_DB=nuvia
POSTGRES_PASSWORD=__generated__

# 32 random bytes, base64. Encrypts MFA secrets at rest. Losing it means every user must set MFA up again.
APP_ENCRYPTION_KEY=__generated__
