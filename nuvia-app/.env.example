# API (apps/api). Copy to apps/api/.env or export. Defaults are fine for local development.
DATABASE_URL=postgres://nuvia:nuvia_dev@127.0.0.1:5432/nuvia
# Required in production (the API refuses to start without them):
JWT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
DEVICE_SECRET_KEY=
HOST=127.0.0.1
PORT=4000
TIMEZONE=Asia/Kolkata

# Office mode: comma-separated CIDRs of the office network. Empty = check-in is not restricted.
OFFICE_NETWORK_CIDRS=
# Set only when the reverse proxy in front of the API/web app is yours and overwrites X-Forwarded-For
# (e.g. "loopback", a number of hops, or true). Leave unset otherwise so the header can't be spoofed.
TRUST_PROXY=

# Remote mode (all optional, defaults shown)
IDLE_MINUTES=10
PROMPT_GRACE_SECONDS=120
AGENT_OFFLINE_SECONDS=180
OFFLINE_AUTOCLOSE_MINUTES=60
CHALLENGE_MEAN_MINUTES=90
CHALLENGE_MIN_GAP_MINUTES=30
MOUSE_ONLY_HOURS=3
HEARTBEAT_RETENTION_DAYS=90
MAX_DEVICES_PER_USER=3

# Web (apps/web)
API_URL=http://127.0.0.1:4000

# Tasks (optional, defaults shown)
# Task attachments are stored on this server's disk. Put it on an encrypted, backed-up volume in production.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
# Remind the assignee when a task is due today or within this many days
DUE_SOON_DAYS=1
